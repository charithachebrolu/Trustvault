# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRUSTVAULT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TRUSTVAULT_DATABASE_PATH=backend/trustvault.db
TRUSTVAULT_STORAGE_DIR=backend/uploads
TRUSTVAULT_MAX_UPLOAD_BYTES=10485760
TRUSTVAULT_COOKIE_SECURE=false
TRUSTVAULT_SESSION_HOURS=8
TRUSTVAULT_CORS_ORIGINS=http://localhost:5173
